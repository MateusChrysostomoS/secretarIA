# ---------------------------------------------------------------------------
# SecretarIA - environment configuration
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Application
APP_ENV=dev
LOG_LEVEL=INFO

# Database (asyncpg driver). For local dev this matches docker-compose.yml.
# In Easypanel, point the host to the internal Postgres service name.
DATABASE_URL=postgresql+asyncpg://secretaria:secretaria@localhost:5432/secretaria

# Redis (used by arq). For local dev this matches docker-compose.yml.
# In Easypanel, point the host to the internal Redis service name.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API
# Find these in https://developers.facebook.com -> your App.
# ---------------------------------------------------------------------------
# App Settings -> Basic -> "App Secret". Used to validate the HMAC signature.
META_APP_SECRET=
# A random string YOU choose. Must match the "Verify token" you type when
# configuring the webhook in the Meta dashboard.
META_VERIFY_TOKEN=change-me-to-a-random-string
# Permanent System User token. WhatsApp -> API Setup (or Business Settings).
META_ACCESS_TOKEN=
# The phone_number_id (NOT the phone number). WhatsApp -> API Setup.
META_PHONE_NUMBER_ID=
# Graph API version, e.g. v21.0
META_GRAPH_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# Precheck hand-off (cosmetic wa.me link only — routing happens server-side
# via brain-api; see BRAIN_API_BASE_URL below and services/precheck.py)
# ---------------------------------------------------------------------------
# The SHARED PreCheck WhatsApp number (digits only) that the wa.me deep link
# points to. Empty disables the hand-off tool (reports unavailable).
PRECHECK_WHATSAPP_NUMBER=
# Cosmetic prefilled text for the wa.me link; routing already happened
# server-side by the time the patient taps it.
PRECHECK_HANDOFF_PREFILL=Olá! Quero fazer minha pré-consulta.

# ---------------------------------------------------------------------------
# Internal API (INBOUND service-to-service)
# ---------------------------------------------------------------------------
# Shared secret that mesh callers (today: brain-api fetching this tenant's
# appointments/patients for the doctor portal) must present on the
# X-Internal-Api-Key header to reach /internal/*. MUST equal brain-api's own
# INTERNAL_API_KEY byte-for-byte. Empty fails CLOSED — /internal/* then rejects
# every caller. Generate a random machine secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Distinct from ADMIN_TOKEN (a different surface).
# This SAME value is also SENT outbound to brain-api when verifying doctor-hub
# subscription tokens (see BRAIN_API_BASE_URL below) — one shared secret, both
# directions.
INTERNAL_API_KEY=
# Rotation window: during a key rotation, put the OLD value here and the NEW
# value in INTERNAL_API_KEY above. Accepted for INBOUND verification only; we
# always SEND INTERNAL_API_KEY outbound. Leave empty outside of a rotation.
INTERNAL_API_KEY_PREVIOUS=

# ---------------------------------------------------------------------------
# brain-api (service-to-service, OUTBOUND) — doctor-hub subscription checks
# ---------------------------------------------------------------------------
# Internal DNS/URL of brain-api. Easypanel: http://brain-api:8000 | Local dev:
# http://localhost:8000. Empty fails CLOSED — the doctor hub then rejects every
# caller (there is nothing to verify a token against). Sends INTERNAL_API_KEY
# above as X-Internal-Api-Key.
BRAIN_API_BASE_URL=
# Timeout (seconds) for the brain-api verification call.
BRAIN_API_TIMEOUT_SECONDS=5.0
# TTL (seconds) of the in-process cache of POSITIVE (active) verification
# results. Bounds brain-api call volume; also the worst-case latency before a
# revoked/canceled subscription actually locks the hub out. <= 0 disables
# caching.
SUBSCRIPTION_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# Entitlement cache (per-tenant addon/tier gating on the bot reply path)
# ---------------------------------------------------------------------------
# TTL (seconds) of the FRESH Redis-cached entitlement read (services/
# entitlements_client.py), consulted once per inbound message. This is the
# revocation-latency ceiling for the bot: the worst-case delay between
# brain-api reporting a tenant as disentitled and the bot actually going
# silent for it. <= 0 disables fresh caching (every message re-fetches). A
# STALE copy is always kept for 24h and used only when a fresh fetch fails,
# so a brief brain-api outage degrades gracefully instead of locking every
# tenant out at once.
ENTITLEMENT_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Handover (bot <-> human secretary)
# ---------------------------------------------------------------------------
# Minutes of human inactivity before a conversation auto-returns to the bot.
HANDOVER_TIMEOUT_MINUTES=30

# Context-aware opening greeting: windows (hours) for the opening-state router.
UPCOMING_SOON_HOURS=48
POST_CONSULT_WINDOW_HOURS=48

# ---------------------------------------------------------------------------
# Onboarding / multi-professional (cross-service contract v1)
# ---------------------------------------------------------------------------
# workers/tasks.py:_resolve_tenant's single-tenant MVP scaffold: when no
# tenant row matches the inbound phone_number_id, fall back to
# META_PHONE_NUMBER_ID and auto-create a Tenant from env settings so the dev
# flow works without a manual seed step. This is dev/single-tenant
# convenience ONLY - leave it false in any multi-tenant/production
# deployment, where an unrecognized phone_number_id must simply be dropped.
ALLOW_WEBHOOK_AUTOPROVISION=false
# Partial-activation threshold (see services/tenant_config.py
# professional_completeness): tenants with this many or fewer active
# professionals need ALL of them fully configured before config_complete;
# above it, one fully-configured professional is enough.
PARTIAL_ACTIVATION_THRESHOLD=10

# ---------------------------------------------------------------------------
# Onboarding nudge crons (workers/onboarding_cron.py - contract v1 §11/§12)
# ---------------------------------------------------------------------------
# Local wall-clock window ("HH:MM-HH:MM") during which retry nudges, the D+60
# closing email, and config reminders may actually be sent (a tenant due
# outside this window just waits for the next hourly tick inside it). The
# D+30 manual-review flag is NOT gated by this window - it sends no message.
NUDGE_SEND_WINDOW=09:00-20:00
# Fixed day-offsets (from onboarding_anchor_at) for the first retry nudges.
# List-typed settings are JSON-decoded from the env string - keep the
# brackets if you override this.
RETRY_CADENCE_DAYS=[3,7,14,21,30]
# Recurring step (days) once RETRY_CADENCE_DAYS is exhausted (D+30 -> D+44 ->
# D+58 with the defaults above).
RETRY_BIWEEKLY_DAYS=14
# Total days after onboarding_anchor_at the auto-retry population is nudged.
# Beyond this, no more nudges are scheduled and the D+60 closing email fires.
RETRY_WINDOW_TOTAL_DAYS=60
# Fixed day-offsets (from config_reminder_anchor_at) for the first config
# reminders. Same JSON-array override format as RETRY_CADENCE_DAYS.
CONFIG_REMINDER_CADENCE_DAYS=[1,3,7]
# Recurring step (days) once CONFIG_REMINDER_CADENCE_DAYS is exhausted.
# Uncapped - config reminders keep recurring until config_status becomes
# 'completa'.
CONFIG_REMINDER_WEEKLY_DAYS=7

# ---------------------------------------------------------------------------
# Inbound rate limiting (per WhatsApp id, Redis-backed)
# ---------------------------------------------------------------------------
# Caps how many inbound messages one wa_id may send in the sliding window before
# the bot goes silent for them (no reply), protecting against floods that would
# otherwise drive unbounded LLM spend.
RATE_LIMIT_MAX_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_SILENCE_SECONDS=300

# ---------------------------------------------------------------------------
# Admin endpoint (POST /admin/reset)
# ---------------------------------------------------------------------------
# Shared secret required on the X-Admin-Token header. Leave empty to keep the
# endpoint DISABLED (returns 503). Guards a DESTRUCTIVE wipe — treat as a
# production credential. brain-api calls this with its SECRETARIA_ADMIN_TOKEN,
# which MUST equal this value byte-for-byte.
ADMIN_TOKEN=
# Rotation window for ADMIN_TOKEN: during a rotation, put the OLD value here
# and the NEW value in ADMIN_TOKEN above. Both are accepted. Leave empty
# outside of a rotation.
ADMIN_TOKEN_PREVIOUS=

# ---------------------------------------------------------------------------
# OpenAI (conversational AI)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Cheap model to start. Bump to a larger one if reasoning quality is too low.
# OPENAI_MODEL is still accepted as a DEPRECATED alias (old deployments that
# only set OPENAI_MODEL keep working), but new config should use this name.
OPENAI_SECRETARIA_MODEL=gpt-5-mini
# Hard cap per call (output + reasoning). For gpt-5-mini / o-series the
# reasoning eats this budget too; setting it < ~1500 produces empty replies.
OPENAI_MAX_TOKENS=2500

# ---------------------------------------------------------------------------
# Audio transcription (inbound WhatsApp voice notes - transcription-core)
# ---------------------------------------------------------------------------
# STT model - NEVER the chat model above (the transcription endpoint rejects
# chat models). whisper-1 / gpt-4o-mini-transcribe / gpt-4o-transcribe.
OPENAI_TRANSCRIPT_MODEL=gpt-4o-mini-transcribe
# Optional fallback STT provider. Empty = openai is the only provider tried.
GROQ_API_KEY=
# Which provider is tried first: "openai" | "groq".
AUDIO_TRANSCRIPTION_PRIMARY=openai
# Domain-specific prompt passed to the STT model to bias transcription of
# clinic/appointment vocabulary. Leave the default unless you have a reason
# to change it.
AUDIO_DOMAIN_PROMPT=Mensagem de voz em português do Brasil enviada à secretária de uma clínica: agendar, remarcar ou cancelar consulta, horários, convênio, exames, receita.

# ---------------------------------------------------------------------------
# Google Calendar (per-tenant in prod; single tenant via env in Fase A)
# ---------------------------------------------------------------------------
# OAuth Web application client created in Google Cloud Console.
# Required redirect URI to register on the client: http://localhost:8080/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Refresh token produced by `uv run python scripts/gcal_auth.py` (Fase A only).
# Multi-tenant: this moves to an encrypted column on `tenants`.
GOOGLE_REFRESH_TOKEN=
# Calendar to read/write. `primary` = the authorising account's main calendar.
GOOGLE_CALENDAR_ID=primary
# IANA timezone the clinic operates in. Used when the LLM passes naive times.
CLINIC_TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Platform encryption (tenant secrets at rest)
# ---------------------------------------------------------------------------
# Fernet key. Generate once with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before any tenant connects a Google Calendar via the hub, AND for the
# per-tenant WhatsApp access token (tenant_credentials.waba_token_encrypted — there is
# no plaintext token column anymore; migration d7e8f9a0b1c2 refuses to run without
# this key while plaintext tokens exist). Losing this key = every tenant reconnects
# Calendar + re-provisions its WhatsApp token.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Doctor hub auth
# ---------------------------------------------------------------------------
# The /tenants/me/* endpoints require `Authorization: Bearer <token>`, an
# opaque subscription token minted by brain-api. It is verified live against
# brain-api on every request (subject to the cache above) — see
# BRAIN_API_BASE_URL and INTERNAL_API_KEY. There is nothing to configure here;
# this section exists as a pointer for anyone looking for the old MVP fake
# token, which has been removed. See docs/CHECKPOINT_onboarding_multiprofessional.md.

# ---------------------------------------------------------------------------
# Google Calendar OAuth (platform-level hub onboarding)
# ---------------------------------------------------------------------------
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above. Register this exact
# redirect URI on the OAuth Web client in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback
# Secret used to sign the OAuth `state` (anti-CSRF). Use a long random string.
OAUTH_STATE_SECRET=change-me-to-a-long-random-string
# Max seconds allowed between starting and finishing the OAuth flow.
OAUTH_STATE_MAX_AGE=600
# Where to send the doctor's browser after the callback (the Next.js portal).
PORTAL_POST_OAUTH_REDIRECT=http://localhost:3000/calendar/connected

# ---------------------------------------------------------------------------
# SMTP (operational alerts to clinic owners)
# ---------------------------------------------------------------------------
# Leave SMTP_HOST empty to disable email alerts (fail-open — the bot still
# degrades gracefully, just without sending the owner a notification email).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=secretaria@yourdomain.com
SMTP_FROM_NAME=SecretarIA
# true = STARTTLS (port 587). false = plain/implicit TLS (port 465).
SMTP_USE_TLS=true
# Seconds between repeated calendar-unavailable emails per tenant (default 4h).
CALENDAR_ALERT_SILENCE_SECONDS=14400

# ---------------------------------------------------------------------------
# Transactional email (onboarding lifecycle - contract v1 §4/§10/§12)
# ---------------------------------------------------------------------------
# A SEPARATE kill switch from the SMTP alert settings above: the ten
# onboarding templates (services/email.py - professional invites, retry/
# config-reminder nudges, connection success, closing email) are OFF by
# default even when SMTP_HOST is already configured for the legacy alerts.
# Reuses SMTP_HOST/SMTP_PORT/SMTP_USERNAME/SMTP_PASSWORD above (same mail
# server) but has its own From identity below.
EMAIL_ENABLED=false
EMAIL_FROM_ADDRESS=secretaria@yourdomain.com
EMAIL_FROM_NAME=SecretarIA

# ---------------------------------------------------------------------------
# Reminders plugin (CORE capability, billed per-send via the reminders Stripe
# meter outside the 24h window — see plugins/reminders.py)
# ---------------------------------------------------------------------------
# Name of the pre-approved Meta utility (HSM) template used for reminders
# sent OUTSIDE the WhatsApp 24h customer-service window. This name must
# already exist and be APPROVED on the tenant's WABA (Business Manager ->
# WhatsApp Manager -> Message Templates) — an unapproved/mismatched name
# fails the send. "appointment_reminder" below is a sandbox/dev-only default;
# name your production template honestly (e.g. per-environment) rather than
# assuming this default is pre-approved anywhere.
REMINDER_TEMPLATE_NAME=appointment_reminder
# Lookback (minutes) the reminder cron adds behind each lead-time window (24h,
# 1h) so a missed/delayed tick still catches appointments that drifted past
# the exact lead time. Must be >= the cron period (5 minutes).
REMINDER_SCAN_WINDOW_MINUTES=15

# ---------------------------------------------------------------------------
# Human backup 24/7 plugin
# ---------------------------------------------------------------------------
# Sent once, verbatim, when a patient messages outside the tenant's business
# hours and the human_backup_24_7 addon is entitled.
HUMAN_BACKUP_ACK_TEXT=Recebi sua mensagem! Nossa equipe humana vai te responder em instantes.

# ---------------------------------------------------------------------------
# CORS (the Next.js doctor portal)
# ---------------------------------------------------------------------------
# Comma-separated allowed origins for the hub API.
CORS_ALLOW_ORIGINS=http://localhost:3000
