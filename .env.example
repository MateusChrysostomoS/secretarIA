# ---------------------------------------------------------------------------
# SecretarIA - environment configuration
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Application
APP_ENV=dev
LOG_LEVEL=INFO

# Database (asyncpg driver). For local dev this matches docker-compose.yml.
# In Easypanel, point the host to the internal Postgres service name.
DATABASE_URL=postgresql+asyncpg://secretaria:secretaria@localhost:5432/secretaria

# Redis (used by arq). For local dev this matches docker-compose.yml.
# In Easypanel, point the host to the internal Redis service name.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API
# Find these in https://developers.facebook.com -> your App.
# ---------------------------------------------------------------------------
# App Settings -> Basic -> "App Secret". Used to validate the HMAC signature.
META_APP_SECRET=
# A random string YOU choose. Must match the "Verify token" you type when
# configuring the webhook in the Meta dashboard.
META_VERIFY_TOKEN=change-me-to-a-random-string
# Permanent System User token. WhatsApp -> API Setup (or Business Settings).
META_ACCESS_TOKEN=
# The phone_number_id (NOT the phone number). WhatsApp -> API Setup.
META_PHONE_NUMBER_ID=
# Graph API version, e.g. v21.0
META_GRAPH_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# Precheck service (separate FastAPI app, already deployed)
# ---------------------------------------------------------------------------
# Easypanel: http://precheck-api:8000  |  Local dev: http://localhost:8001
PRECHECK_BASE_URL=http://localhost:8001
# OUTBOUND shared secret we SEND to precheck (X-Internal-Api-Key header).
PRECHECK_API_KEY=

# ---------------------------------------------------------------------------
# Internal API (INBOUND service-to-service)
# ---------------------------------------------------------------------------
# Shared secret that mesh callers (today: brain-api fetching this tenant's
# appointments/patients for the doctor portal) must present on the
# X-Internal-Api-Key header to reach /internal/*. MUST equal brain-api's own
# INTERNAL_API_KEY byte-for-byte. Empty fails CLOSED — /internal/* then rejects
# every caller. Generate a random machine secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Distinct from PRECHECK_API_KEY (outbound) and ADMIN_TOKEN (a different surface).
INTERNAL_API_KEY=

# ---------------------------------------------------------------------------
# Handover (bot <-> human secretary)
# ---------------------------------------------------------------------------
# Minutes of human inactivity before a conversation auto-returns to the bot.
HANDOVER_TIMEOUT_MINUTES=30

# ---------------------------------------------------------------------------
# Inbound rate limiting (per WhatsApp id, Redis-backed)
# ---------------------------------------------------------------------------
# Caps how many inbound messages one wa_id may send in the sliding window before
# the bot goes silent for them (no reply), protecting against floods that would
# otherwise drive unbounded LLM spend.
RATE_LIMIT_MAX_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_SILENCE_SECONDS=300

# ---------------------------------------------------------------------------
# Admin endpoint (POST /admin/reset)
# ---------------------------------------------------------------------------
# Shared secret required on the X-Admin-Token header. Leave empty to keep the
# endpoint DISABLED (returns 503). Guards a DESTRUCTIVE wipe — treat as a
# production credential. brain-api calls this with its SECRETARIA_ADMIN_TOKEN,
# which MUST equal this value byte-for-byte.
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# OpenAI (conversational AI)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Cheap model to start. Bump to a larger one if reasoning quality is too low.
OPENAI_MODEL=gpt-5-mini
# Hard cap per call (output + reasoning). For gpt-5-mini / o-series the
# reasoning eats this budget too; setting it < ~1500 produces empty replies.
OPENAI_MAX_TOKENS=2500

# ---------------------------------------------------------------------------
# Google Calendar (per-tenant in prod; single tenant via env in Fase A)
# ---------------------------------------------------------------------------
# OAuth Web application client created in Google Cloud Console.
# Required redirect URI to register on the client: http://localhost:8080/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Refresh token produced by `uv run python scripts/gcal_auth.py` (Fase A only).
# Multi-tenant: this moves to an encrypted column on `tenants`.
GOOGLE_REFRESH_TOKEN=
# Calendar to read/write. `primary` = the authorising account's main calendar.
GOOGLE_CALENDAR_ID=primary
# IANA timezone the clinic operates in. Used when the LLM passes naive times.
CLINIC_TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Platform encryption (tenant secrets at rest)
# ---------------------------------------------------------------------------
# Fernet key. Generate once with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before any tenant connects a Google Calendar via the hub.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Doctor hub auth (MVP fake-token seam)
# ---------------------------------------------------------------------------
# Placeholder "subscription" token. Send it as `Authorization: Bearer <token>`
# to the /tenants/me/* endpoints. This is a stand-in until the Payments API
# exists — the only code to change later is core/subscription.py. See
# docs/doctor-hub-backend.md.
MVP_FAKE_TOKEN=dev-secret-change-me
# Which tenant the fake token maps to. Leave empty if there is exactly one
# tenant row; set the UUID once there is more than one.
MVP_FAKE_TOKEN_TENANT_ID=

# ---------------------------------------------------------------------------
# Google Calendar OAuth (platform-level hub onboarding)
# ---------------------------------------------------------------------------
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above. Register this exact
# redirect URI on the OAuth Web client in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback
# Secret used to sign the OAuth `state` (anti-CSRF). Use a long random string.
OAUTH_STATE_SECRET=change-me-to-a-long-random-string
# Max seconds allowed between starting and finishing the OAuth flow.
OAUTH_STATE_MAX_AGE=600
# Where to send the doctor's browser after the callback (the Next.js portal).
PORTAL_POST_OAUTH_REDIRECT=http://localhost:3000/calendar/connected

# ---------------------------------------------------------------------------
# SMTP (operational alerts to clinic owners)
# ---------------------------------------------------------------------------
# Leave SMTP_HOST empty to disable email alerts (fail-open — the bot still
# degrades gracefully, just without sending the owner a notification email).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=secretaria@yourdomain.com
SMTP_FROM_NAME=SecretarIA
# true = STARTTLS (port 587). false = plain/implicit TLS (port 465).
SMTP_USE_TLS=true
# Seconds between repeated calendar-unavailable emails per tenant (default 4h).
CALENDAR_ALERT_SILENCE_SECONDS=14400

# ---------------------------------------------------------------------------
# CORS (the Next.js doctor portal)
# ---------------------------------------------------------------------------
# Comma-separated allowed origins for the hub API.
CORS_ALLOW_ORIGINS=http://localhost:3000
